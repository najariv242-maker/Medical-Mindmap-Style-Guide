# توکن ربات تلگرام جدید (دریافتی از @BotFather برای ربات تولیدکننده مارک‌داون)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# کلید هوش مصنوعی شما (پشتیبانی کامل از Google AI Studio با پیشوند AQ. و AIza، و CodeCraft)
AI_API_KEY=AQ.Ab8RN6KWuLT-fUlCygajyDzunN7T21lP-RBU7Y3t_uOOv5dgAQ

# مدل پیش‌فرض هوش مصنوعی (مدل منتخب: gemini-flash-latest با قابلیت Fallback خودکار)
AI_MODEL=gemini-flash-latest

# آدرس پایه وب‌سرویس OpenAI/CodeCraft (در صورت استفاده از کلید‌های sk- یا cc_)
# OPENAI_BASE_URL=https://codecraftapi.com/v1

# حداکثر درخواست‌های هم‌زمان هوش مصنوعی
